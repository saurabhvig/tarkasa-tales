---
/**
 * THEMED EDITION PAGE: /editions/<edition>/ (e.g. /editions/women-who-asked-big-questions/)
 * One page per forthcoming edition in src/content/editions/. A published edition links to its own book page instead,
 * where the Buy on Amazon button lives, so this page is only made while an edition is forthcoming.
 * Nothing here is invented: no cover, price, date, ISBN or Amazon link until the edition really exists.
 * "What children will learn" is taken from the approved outcomes of the books inside.
 */
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookCard from '../../components/BookCard.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { type Book, bookUrl, collectionUrl, coverAlt, getResourcesForBook } from '../../lib/books';
import ActivityCard from '../../components/ActivityCard.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const editions = await getCollection('editions', (e) => e.data.status === 'forthcoming');
  return editions.map((e) => ({ params: { slug: e.id }, props: { edition: e } }));
}
const { edition: e } = Astro.props;
const d = e.data;
const { Content } = await render(e);
const collection = await getEntry(d.collection);
const books = (await Promise.all(d.includes.map((r) => getEntry(r)))).filter(Boolean) as Book[];
const science = books.flatMap((b) => b.data.learningOutcomes.science.filter((o) => !o.startsWith('Who ')).slice(0, 1).map((o) => [b, o] as const));
const who = books.map((b) => [b, b.data.learningOutcomes.science.find((o) => o.startsWith('Who '))] as const).filter(([, o]) => o);
const growth = books.flatMap((b) => b.data.learningOutcomes.growth.slice(0, 1).map((o) => [b, o] as const));
// One printable per story (each book's own first), plus anything that suits all of them.
const printables = (await Promise.all(books.map(async (b) => (await getResourcesForBook(b)).own[0]))).filter(Boolean);
const url = new URL(`/editions/${e.id}/`, SITE.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: d.title,
  description: d.seoDescription ?? d.summary,
  url,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  about: books.map((b) => ({ '@type': 'Person', name: b.data.title })),
  mainEntity: { '@type': 'ItemList', name: `Stories in ${d.title}`, itemListElement: books.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(bookUrl(b), SITE.url).href, name: b.data.title })) },
};
---
<BaseLayout title={`${d.title}: Three-Story Picture Book (Ages ${d.ageMin}–${d.ageMax})`} description={d.seoDescription ?? d.summary} jsonLd={ld}>
  <section class="bg-lavender-soft text-plum-deep">
    <div class="container-site grid items-center gap-10 py-10 lg:grid-cols-[1.1fr_1fr] lg:py-14">
      <div class="flex flex-col gap-5">
        <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: collectionUrl(collection!), label: collection!.data.title }, { label: d.title }]} onColor />
        <p class="flex flex-wrap gap-2"><span class="pill bg-yellow">Forthcoming edition</span><span class="pill bg-white">Ages {d.ageMin}–{d.ageMax} · {books.length} stories in one book</span></p>
        <h1 class="text-5xl sm:text-6xl !text-plum-deep">{d.title}</h1>
        {d.subtitle && <p class="font-display text-2xl font-medium">{d.subtitle}</p>}
        <div class="prose-tt max-w-[60ch] text-lg"><Content /></div>
        <p class="rounded-2xl bg-white p-4 font-bold">Not yet available to buy. We’ll announce it in the Learning Club first. No date or price has been set yet.</p>
      </div>
      <ul class="grid grid-cols-3 gap-3 sm:gap-5" aria-label={`Stories in ${d.title}`}>
        {books.map((b, i) => (
          <li class:list={['flex flex-col gap-2', i === 1 && 'lg:-translate-y-4']}>
            <a href={bookUrl(b)} class="flex flex-col gap-2 font-extrabold text-plum-deep no-underline hover:underline">
              <Image src={b.data.cover} alt={coverAlt(b)} widths={[240, 400]} sizes="(min-width: 1024px) 180px, 30vw" class="aspect-square w-full rounded-2xl border-4 border-white object-cover shadow-[0_10px_24px_rgba(46,33,64,0.18)]" />
              <span class="text-center leading-tight">{b.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="container-site flex flex-col gap-14 py-12">
    <section aria-labelledby="learn" class="flex flex-col gap-6">
      <h2 id="learn" class="text-[2.1rem]">What children will take away</h2>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="flex flex-col gap-3 rounded-[var(--radius-card)] bg-white p-6">
          <h3 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em]">Three scientists</h3>
          <ul class="prose-tt">{who.map(([, o]) => <li>{o}</li>)}</ul>
        </div>
        <div class="flex flex-col gap-3 rounded-[var(--radius-card)] bg-mint-soft p-6 text-plum-deep">
          <h3 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] !text-plum-deep">Science learning</h3>
          <ul class="prose-tt">{science.map(([, o]) => <li>{o}</li>)}</ul>
        </div>
        <div class="flex flex-col gap-3 rounded-[var(--radius-card)] bg-yellow-soft p-6 text-plum-deep">
          <h3 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] !text-plum-deep">Personal growth</h3>
          <ul class="prose-tt">{growth.map(([, o]) => <li>{o}</li>)}</ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="read-now" class="flex flex-col gap-6">
      <div class="flex max-w-3xl flex-col gap-2">
        <h2 id="read-now" class="text-[2.1rem]">Read the stories now</h2>
        <p class="text-lg">Each story is already available as its own {collection!.data.title} picture book.</p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {books.map((b) => <li class="flex [&>*]:w-full"><BookCard book={b} /></li>)}
      </ul>
    </section>

    {printables.length > 0 && (
      <section aria-labelledby="free" class="flex flex-col gap-6">
        <h2 id="free" class="text-[2.1rem]">Free printables for these stories</h2>
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {printables.map((r) => <li class="flex [&>*]:w-full"><ActivityCard resource={r!} headingLevel="h3" placement="edition-page" /></li>)}
        </ul>
      </section>
    )}

    <NewsletterSignup id="edition-signup" source={`edition-${e.id}`} title="Hear first when it’s ready" compact />
  </div>
</BaseLayout>
