---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import Planet from '../../components/Planet.astro';
import EditionCard from '../../components/EditionCard.astro';
import { getAllBooks, getAllSeries, getActiveCollections, getTopicsInUse, getQualitiesInUse, getVisibleEditions, topicHref } from '../../lib/books';

const books = await getAllBooks();
const series = await getAllSeries();
const collections = await getActiveCollections();
const topics = await getTopicsInUse();
const qualities = await getQualitiesInUse();
const editions = await getVisibleEditions();
const collectionOfSeries = Object.fromEntries(series.map((s) => [s.id, s.data.collection.id]));
const hasMultiStory = books.some((b) => b.data.storyCount);
const ages = [...new Set(books.flatMap((b) => Array.from({ length: b.data.ageMax - b.data.ageMin + 1 }, (_, i) => b.data.ageMin + i)))].sort((a, b) => a - b);
const seriesNames = Object.fromEntries(series.map((s) => [s.id, s.data.title]));
---
<BaseLayout
  title="Our Books"
  description="Browse every Tarkasa Tales picture book for ages 4–8. Filter by collection, topic, what it helps with, age and availability."
>
  <div class="container-site flex flex-col gap-8 py-12 lg:py-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-2xl flex-col gap-3">
        <h1 class="text-5xl sm:text-6xl">Our Books</h1>
        <p class="text-lg sm:text-xl">Every Tarkasa Tales book in one place. Narrow down by collection, by topic, or by what you’d like the book to help with.</p>
        <p><a href="/topics/" class="font-extrabold">Browse by topic <span aria-hidden="true">→</span></a></p>
      </div>
      <Planet size={150} class="hidden sm:block" />
    </div>

    <form id="book-filters" data-series-map={JSON.stringify(collectionOfSeries)} role="search" aria-label="Filter books" class="js-only grid gap-4 rounded-[1.75rem] bg-white p-5 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-1.5 sm:col-span-2 lg:col-span-3">
        <label for="f-q" class="text-sm font-extrabold text-plum-deep">Search by title</label>
        <input id="f-q" name="q" type="search" autocomplete="off" placeholder="e.g. Marie Curie" class="min-h-12 w-full rounded-full border-2 border-[#9C8DB0] bg-cream px-5 text-base text-plum-deep placeholder:text-ink-soft" />
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="f-collection" class="text-sm font-extrabold text-plum-deep">Collection</label>
        <select id="f-collection" name="collection" class="f-select">
          <option value="">All collections</option>
          {collections.map((c) => <option value={c.id}>{c.data.title}</option>)}
        </select>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="f-topic" class="text-sm font-extrabold text-plum-deep">Topic</label>
        <select id="f-topic" name="topic" class="f-select">
          <option value="">Any topic</option>
          {topics.map((t) => <option value={t.topic.id}>{t.topic.data.title}</option>)}
        </select>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="f-helps" class="text-sm font-extrabold text-plum-deep">Helps with</label>
        <select id="f-helps" name="helps" class="f-select">
          <option value="">Anything</option>
          {qualities.map((q) => <option value={q.quality.id}>{q.quality.data.title}</option>)}
        </select>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="f-age" class="text-sm font-extrabold text-plum-deep">Child’s age</label>
        <select id="f-age" name="age" class="f-select">
          <option value="">Any age</option>
          {ages.map((a) => <option value={a}>{a} years</option>)}
        </select>
      </div>
      {hasMultiStory && (
        <div class="flex flex-col gap-1.5">
          <label for="f-kind" class="text-sm font-extrabold text-plum-deep">Stories per book</label>
          <select id="f-kind" name="kind" class="f-select">
            <option value="">Any</option>
            <option value="single">One story</option>
            <option value="multi">Several stories in one book</option>
          </select>
        </div>
      )}
      <fieldset class="flex flex-wrap items-center gap-2 sm:col-span-2 lg:col-span-3">
        <legend class="mb-2 text-sm font-extrabold text-plum-deep">Availability</legend>
        {[['', 'All'], ['published', 'Available now'], ['coming-soon', 'Coming Soon']].map(([v, l]) => (
          <label class="status-chip">
            <input type="radio" name="status" value={v} checked={v === ''} class="sr-only" />
            <span>{l}</span>
          </label>
        ))}
        <button type="reset" id="f-reset" class="ml-auto min-h-11 rounded-full px-4 font-extrabold text-plum underline underline-offset-4">Clear filters</button>
      </fieldset>
    </form>

    <p id="result-count" class="js-only font-bold text-ink-soft" role="status" aria-live="polite">Showing {books.length} {books.length === 1 ? 'book' : 'books'}</p>

    <ul id="book-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {books.map((b, i) => (
        <li
          class="flex"
          data-title={`${b.data.title} ${b.data.subtitle ?? ''} ${seriesNames[b.data.series.id] ?? ''}`.toLowerCase()}
          data-series={b.data.series.id}
          data-collection={collectionOfSeries[b.data.series.id]}
          data-topics={b.data.topics.map((r) => r.id).join('|')}
          data-helps={b.data.qualities.map((r) => r.id).join('|')}
          data-kind={b.data.storyCount ? 'multi' : 'single'}
          data-status={b.data.status}
          data-age-min={b.data.ageMin}
          data-age-max={b.data.ageMax}
        >
          <BookCard book={b} headingLevel="h2" loading={i < 4 ? 'eager' : 'lazy'} />
        </li>
      ))}
    </ul>
    <div id="no-results" hidden class="rounded-[1.75rem] bg-white p-10 text-center">
      <h2 class="text-2xl">No books match those filters</h2>
      <p class="mt-2">Try another search, or <button type="button" id="no-results-reset" class="font-extrabold text-plum underline underline-offset-4">clear all filters</button>.</p>
    </div>

    {editions.length > 0 && (
      <section aria-labelledby="editions" class="flex flex-col gap-5 pt-6">
        <div class="flex flex-col gap-1">
          <p class="eyebrow">Several stories in one book</p>
          <h2 id="editions" class="text-[2.1rem]">Themed editions</h2>
        </div>
        {editions.map((e) => <EditionCard edition={e} />)}
      </section>
    )}

    <section aria-labelledby="topics-heading" class="flex flex-col gap-4 rounded-[var(--radius-panel)] bg-white p-6 sm:p-8">
      <h2 id="topics-heading" class="text-[1.9rem]">Browse by topic</h2>
      <ul class="flex flex-wrap gap-2.5">
        {topics.map((t) => <li><a href={topicHref(t)} class="topic-chip">{t.topic.data.title} <span class="font-bold text-ink-soft">({t.published.length})</span></a></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  :global(.no-js) .js-only { display: none; }
  #book-grid > li > :global(article) { width: 100%; }
  .f-select { min-height: 3rem; border-radius: 999px; border: 2px solid #9C8DB0; background: var(--color-cream); padding: 0 1rem; font-size: 1rem; color: var(--color-plum-deep); }
  .status-chip span {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.25rem; border-radius: 999px;
    border: 2px solid var(--color-plum); background: #fff; color: var(--color-plum); font-weight: 800; cursor: pointer;
  }
  .status-chip input:checked + span { background: var(--color-plum); color: var(--color-cream); }
  .status-chip input:focus-visible + span { outline: 3px solid var(--color-plum); outline-offset: 3px; box-shadow: 0 0 0 6px var(--color-yellow); }
</style>

<script>
  const form = document.getElementById('book-filters') as HTMLFormElement | null;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#book-grid > li'));
  const count = document.getElementById('result-count');
  const empty = document.getElementById('no-results');

  function apply(updateUrl = true) {
    if (!form) return;
    const fd = new FormData(form);
    const q = String(fd.get('q') ?? '').trim().toLowerCase();
    const collection = String(fd.get('collection') ?? '');
    const topic = String(fd.get('topic') ?? '');
    const helps = String(fd.get('helps') ?? '');
    const kind = String(fd.get('kind') ?? '');
    const age = String(fd.get('age') ?? '');
    const status = String(fd.get('status') ?? '');
    let shown = 0;
    for (const li of items) {
      const d = li.dataset;
      const ok =
        (!q || (d.title ?? '').includes(q)) &&
        (!collection || d.collection === collection) &&
        (!topic || (d.topics ?? '').split('|').includes(topic)) &&
        (!helps || (d.helps ?? '').split('|').includes(helps)) &&
        (!kind || d.kind === kind) &&
        (!status || d.status === status) &&
        (!age || (Number(d.ageMin) <= Number(age) && Number(age) <= Number(d.ageMax)));
      li.hidden = !ok;
      if (ok) shown++;
    }
    if (count) count.textContent = `Showing ${shown} ${shown === 1 ? 'book' : 'books'}`;
    if (empty) empty.hidden = shown !== 0;
    if (updateUrl) {
      const params = new URLSearchParams();
      if (q) params.set('q', q);
      if (collection) params.set('collection', collection);
      if (topic) params.set('topic', topic);
      if (helps) params.set('helps', helps);
      if (kind) params.set('kind', kind);
      if (age) params.set('age', age);
      if (status) params.set('status', status);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }
  }

  if (form) {
    // Restore filters from the address bar, e.g. /books/?series=big-questions
    const p = new URLSearchParams(location.search);
    (form.elements.namedItem('q') as HTMLInputElement).value = p.get('q') ?? '';
    const sel = (name: string) => form.elements.namedItem(name) as HTMLSelectElement;
    // Old links such as /books/?series=big-questions still work: they select that series' collection.
    const SERIES_TO_COLLECTION: Record<string, string> = JSON.parse(form.dataset.seriesMap ?? '{}');
    const wantCollection = p.get('collection') ?? SERIES_TO_COLLECTION[p.get('series') ?? ''] ?? '';
    const pick = (name: string, value: string | null) => {
      const el = form.elements.namedItem(name) as HTMLSelectElement | null;
      if (el && value && [...el.options].some((o) => o.value === value)) el.value = value;
    };
    pick('collection', wantCollection);
    pick('topic', p.get('topic'));
    pick('helps', p.get('helps'));
    pick('kind', p.get('kind'));
    if ([...sel('age').options].some((o) => o.value === p.get('age'))) sel('age').value = p.get('age')!;
    const st = p.get('status') ?? '';
    form.querySelectorAll<HTMLInputElement>('input[name="status"]').forEach((r) => (r.checked = r.value === st));
    apply(false);

    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', () => apply());
    form.addEventListener('change', () => apply());
    form.addEventListener('reset', () => setTimeout(() => apply(), 0));
    document.getElementById('no-results-reset')?.addEventListener('click', () => { form.reset(); (form.elements.namedItem('q') as HTMLInputElement).focus(); });
  }
</script>
