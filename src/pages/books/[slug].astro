---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AmazonButtons from '../../components/AmazonButtons.astro';
import AmazonReview from '../../components/AmazonReview.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import BookVideo from '../../components/BookVideo.astro';
import { getCollection } from 'astro:content';
import BookCard from '../../components/BookCard.astro';
import ExampleBadge from '../../components/ExampleBadge.astro';
import WhatsInside from '../../components/WhatsInside.astro';
import FeelingsInside from '../../components/FeelingsInside.astro';
import AboutCreator from '../../components/AboutCreator.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import BuyBar from '../../components/BuyBar.astro';
import { editionUrl, type Book, getAllBooks, getBooksInCollection, seriesOf, collectionOf, collectionUrl, editionsWithBook, getTopicsInUse, getResourcesForBook, getQualitiesInUse, topicHref, ageLabel, coverAlt, formatDate, seriesUrl, amazonLinks, SERIES_COLORS } from '../../lib/books';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const books = await getAllBooks();
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

interface Props { book: Book }
const { book } = Astro.props;
const d = book.data;
const series = await seriesOf(book);
const collection = await collectionOf(book);
const col = SERIES_COLORS[collection.data.color];
const { Content } = await render(book);
// "More from this collection": newest first, so readers find the latest books.
const related = (await getBooksInCollection(collection.id)).filter((b) => b.id !== book.id).reverse().slice(0, 4);
const editions = await editionsWithBook(book);
// Topic and "helps with" links: only topics/qualities that are shown on the site.
const topicLinks = (await getTopicsInUse()).filter((t) => d.topics.some((r) => r.id === t.topic.id));
const qualityLinks = (await getQualitiesInUse()).filter((q) => d.qualities.some((r) => r.id === q.quality.id));
const { science, growth, activity } = d.learningOutcomes;
const isScience = collection.id === 'little-scientists';
// The first outcome list is about science for science books, and about the story and its culture for traditional tales.
const knowledgeLabel = isScience ? 'Science learning' : 'Story and culture';
const soon = d.status === 'coming-soon';
const bookReviews = (await getCollection('testimonials', (t) => t.data.book?.id === book.id)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// Free printables: this book's own first, then ones that also suit it (e.g. the observation journal).
const { own: ownResources, suits: suitsResources } = await getResourcesForBook(book);
const printables = [...ownResources, ...suitsResources];
const ogImg = await getImage({ src: d.cover, width: 800, format: 'jpg' });
// Large versions for the picture viewer (cover first, then inside pages).
const big = (src: ImageMetadata) => getImage({ src, width: 1400, format: 'webp', quality: 82 });
const coverBig = await big(d.cover);
const samplesBig = await Promise.all(d.samples.map((s) => big(s.src)));

const details: [string, string | undefined][] = [
  ['Collection', collection.data.title],
  ['Series', series.data.title + (d.seriesNumber ? ` · Book ${d.seriesNumber}` : '')],
  ['Stories', d.storyCount ? `${d.storyCount} stories in one book` : undefined],
  ['Also in', editions.length ? editions.map((e) => `${e.data.title}${e.data.status === 'forthcoming' ? ' (forthcoming edition)' : ''}`).join('; ') : undefined],
  ['Author', d.author],
  ['Illustrator', d.illustrator],
  ['Recommended age', ageLabel(book).replace(/^Ages? /, '')],
  ['Language', d.language],
  ['Pages', d.pageCount?.toString()],
  ['Formats', d.formats.length ? d.formats.join(', ') : undefined],
  ['Published', formatDate(d.publicationDate)],
  ['Expected release', soon ? d.expectedRelease : undefined],
  ['ISBN', d.isbn],
  ['ASIN', d.asin],
  ['Status', soon ? 'Coming soon' : 'Published'],
];

// Search result title: the book's name plus what it is, e.g. "Marie Curie Picture Book for Kids (Ages 4–8)".
const ages = `Ages ${d.ageMin}–${d.ageMax}`;
const seoTitle = d.seoTitle ?? (
  collection.id === 'little-scientists' ? `${d.title} Picture Book for Kids (${ages})`
  : collection.id === 'bobbins-world' ? `${d.title}: Big Feelings Picture Book (${ages})`
  : d.subtitle ? `${d.title}: ${d.subtitle} for Kids` : `${d.title}: Picture Book for Kids (${ages})`);
const formatLd: Record<string, string> = { Paperback: 'https://schema.org/Paperback', Hardcover: 'https://schema.org/Hardcover', 'Kindle eBook': 'https://schema.org/EBook' };
const bookLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: d.title,
  ...(d.subtitle ? { alternativeHeadline: d.subtitle } : {}),
  author: { '@type': 'Person', name: d.author },
  ...(d.illustrator ? { illustrator: { '@type': 'Person', name: d.illustrator } } : {}),
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  isPartOf: { '@type': 'BookSeries', name: series.data.title, url: new URL(seriesUrl(series), SITE.url).href },
  inLanguage: d.language,
  typicalAgeRange: `${d.ageMin}-${d.ageMax}`,
  audience: { '@type': 'PeopleAudience', suggestedMinAge: d.ageMin, suggestedMaxAge: d.ageMax },
  genre: collection.id === 'little-scientists' ? ['Children’s picture book', 'Biography'] : collection.id === 'timeless-tales' ? ['Children’s picture book', 'Mythology'] : ['Children’s picture book', 'Social and emotional learning'],
  ...(collection.id === 'little-scientists' ? { about: { '@type': 'Person', name: d.title } } : {}),
  ...(d.formats.length ? { workExample: d.formats.map((f) => ({ '@type': 'Book', bookFormat: formatLd[f], ...(f === 'Paperback' && d.isbn ? { isbn: d.isbn } : {}) })) } : {}),
  description: d.shortDescription,
  image: new URL(ogImg.src, SITE.url).href,
  url: new URL(`/books/${book.id}/`, SITE.url).href,
  ...(d.pageCount ? { numberOfPages: d.pageCount } : {}),
  ...(d.isbn ? { isbn: d.isbn } : {}),
  ...(d.publicationDate ? { datePublished: d.publicationDate.toISOString().slice(0, 10) } : {}),
  ...(amazonLinks(book).length ? { sameAs: amazonLinks(book).map((l) => l.url) } : {}),
};
---
<BaseLayout
  title={seoTitle}
  description={d.seoDescription ?? d.shortDescription}
  image={ogImg.src}
  imageAlt={coverAlt(book)}
  type="book"
  noindex={d.example}
  jsonLd={d.example ? undefined : bookLd}
>
  <div class="container-site flex flex-col gap-14 py-8 lg:py-10">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: collectionUrl(collection), label: collection.data.title }, { href: seriesUrl(series), label: series.data.title }, { label: d.title }]} />

    {d.example && (
      <p class="rounded-2xl border-2 border-dashed border-plum-deep bg-yellow-soft p-4 font-bold text-plum-deep">
        This is an example listing used to preview the design. It will be replaced with real book details before launch, and search engines are told not to index it.
      </p>
    )}

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-x-16 lg:gap-y-6">
      <div class="lg:col-start-1 lg:row-start-1">
        <div class="relative mx-auto max-w-[16rem] sm:max-w-[22rem] lg:max-w-none">
          <div class:list={['absolute inset-[1.5rem_-1rem_-1rem_1.5rem] rounded-[2rem]', col.panel]} aria-hidden="true"></div>
          <a href={coverBig.src} data-lightbox="book-pictures" data-alt={coverAlt(book)} class="group relative block rounded-2xl cursor-zoom-in">
            <Image src={d.cover} alt={coverAlt(book)} widths={[360, 540, 720, 900]} sizes="(min-width: 1024px) 416px, 90vw" loading="eager" fetchpriority="high" class="relative w-full rounded-2xl shadow-[0_24px_40px_rgba(46,33,64,0.18)]" />
            <span class="absolute bottom-3 right-3 rounded-full bg-white/95 px-3 py-1.5 text-sm font-extrabold text-plum shadow" aria-hidden="true">Look inside</span>
            <span class="sr-only"> (view larger pictures)</span>
          </a>
        </div>
      </div>
      {d.samples.length > 0 && (
          <section aria-labelledby="inside" class="order-last flex flex-col gap-3 lg:order-none lg:col-start-1 lg:row-start-2 lg:mt-6">
            <h2 id="inside" class="eyebrow !font-sans">Inside the book <span class="normal-case tracking-normal font-bold">· tap a page to look closer</span></h2>
            <ul class="grid grid-cols-3 gap-3">
              {d.samples.map((s, n) => (
                <li>
                  <a href={samplesBig[n].src} data-lightbox="book-pictures" data-alt={s.alt} class="block overflow-hidden rounded-xl cursor-zoom-in transition hover:-translate-y-0.5 hover:shadow-[0_8px_18px_rgba(46,33,64,0.18)]">
                    <Image src={s.src} alt={s.alt} widths={[160, 320]} sizes="130px" class="aspect-square w-full object-cover" />
                    <span class="sr-only"> (view larger)</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
      )}

      <div class="flex min-w-0 flex-col gap-6 lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <div class="flex flex-wrap items-center gap-2">
          <a href={collectionUrl(collection)} class:list={['pill no-underline !text-[0.875rem]', col.panel]}>{collection.data.title}</a>
          <a href={seriesUrl(series)} class="text-[0.9375rem] font-extrabold text-ink-soft">{series.data.title}{d.seriesNumber && `, Book ${d.seriesNumber}`}</a>
          {soon && <span class="pill bg-coral">Coming Soon</span>}
          {d.example && <ExampleBadge />}
        </div>
        <div class="flex flex-col gap-2">
          <h1 class="text-[2.6rem] sm:text-[3.4rem]">{d.title}</h1>
          {d.subtitle && <p class="font-display text-2xl font-medium text-plum">{d.subtitle}</p>}
          <p class="text-lg">by <strong class="text-plum-deep">{d.author}</strong>{d.illustrator && <> · illustrated by <strong class="text-plum-deep">{d.illustrator}</strong></>}</p>
        </div>
        <p class="text-[1.0625rem] font-bold text-plum-deep sm:hidden">{[`Ages ${d.ageMin}–${d.ageMax}`, d.pageCount && `${d.pageCount} pages`, d.formats.map((f) => f.replace(' eBook', '')).join(' · ')].filter(Boolean).join(' · ')}</p>
        <dl class="hidden grid-cols-2 gap-3 sm:grid sm:grid-cols-4">
          <div class="rounded-2xl bg-white p-4"><dt class="text-xs font-extrabold uppercase tracking-[0.08em] text-ink-soft">Ages</dt><dd class="text-lg font-extrabold text-plum-deep">{d.ageMin}–{d.ageMax}</dd></div>
          {d.pageCount && <div class="rounded-2xl bg-white p-4"><dt class="text-xs font-extrabold uppercase tracking-[0.08em] text-ink-soft">Pages</dt><dd class="text-lg font-extrabold text-plum-deep">{d.pageCount}</dd></div>}
          {d.formats.length > 0 && <div class="rounded-2xl bg-white p-4"><dt class="text-xs font-extrabold uppercase tracking-[0.08em] text-ink-soft">Format</dt><dd class="text-lg font-extrabold text-plum-deep">{d.formats.join(' · ')}</dd></div>}
          <div class="rounded-2xl bg-white p-4"><dt class="text-xs font-extrabold uppercase tracking-[0.08em] text-ink-soft">Language</dt><dd class="text-lg font-extrabold text-plum-deep">{d.language}</dd></div>
        </dl>
        <p class="text-xl leading-relaxed max-sm:order-2">{d.shortDescription}</p>
        <div id="buy" class="scroll-mt-24 flex flex-col gap-3 max-sm:order-1">
          <AmazonButtons book={book} />
          {editions.length > 0 && (
            <p class="text-[0.9375rem] text-ink-soft">
              Also in: {editions.map((e, i) => <>{i > 0 && ', '}<a href={editionUrl(e)} class="font-bold">{e.data.title}</a>{e.data.status === 'forthcoming' && ' (forthcoming edition, not yet available)'}</>)}
            </p>
          )}
        </div>
        {(science.length > 0 || growth.length > 0 || activity.length > 0) && (
          <section aria-labelledby="outcomes" class:list={['max-sm:order-3 flex flex-col gap-4 rounded-[var(--radius-card)] p-5 sm:p-6 text-plum-deep', col.soft]}>
            <h2 id="outcomes" class="text-[1.5rem] !text-plum-deep">What your child will take away</h2>
            <div class:list={['grid gap-5', science.length > 0 && growth.length > 0 && 'sm:grid-cols-2']}>
              {science.length > 0 && (
                <div class="flex flex-col gap-2">
                  <h3 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] !text-plum-deep">{knowledgeLabel}</h3>
                  <ul class="prose-tt !text-[1.0625rem]">{science.map((o) => <li>{o}</li>)}</ul>
                </div>
              )}
              {growth.length > 0 && (
                <div class="flex flex-col gap-2">
                  <h3 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] !text-plum-deep">Personal growth</h3>
                  <ul class="prose-tt !text-[1.0625rem]">{growth.map((o) => <li>{o}</li>)}</ul>
                </div>
              )}
            </div>
            {activity.length > 0 && (
              <div class="flex flex-col gap-2 border-t border-plum-deep/15 pt-4">
                <h3 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] !text-plum-deep">Try it together</h3>
                <ul class="prose-tt !text-[1.0625rem]">{activity.map((o) => <li>{o}</li>)}</ul>
              </div>
            )}
          </section>
        )}
        {d.video && <div class="max-sm:order-3"><BookVideo book={book} /></div>}
        <div class="max-sm:order-3"><AmazonReview book={book} /></div>
      </div>
    </div>

    <FeelingsInside book={book} />

    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <section aria-labelledby="about-book" class="flex flex-col gap-4">
        <h2 id="about-book" class="text-[2.1rem]">About this book</h2>
        <div class="prose-tt max-w-[65ch]"><Content /></div>
        {d.themes.length > 0 && (
          <>
            <h3 class="mt-4 text-2xl">What children will explore</h3>
            <ul class="flex flex-wrap gap-2.5">
              {d.themes.map((t, i) => <li class:list={['rounded-full px-4 py-2 font-bold text-plum-deep', ['bg-mint-soft', 'bg-lavender-soft', 'bg-yellow-soft', 'bg-coral-soft'][i % 4]]}>{t}</li>)}
            </ul>
          </>
        )}
        {(topicLinks.length > 0 || qualityLinks.length > 0) && (
          <nav aria-labelledby="similar" class="mt-4 flex flex-col gap-3">
            <h3 id="similar" class="text-2xl">Find more books like this</h3>
            <ul class="flex flex-wrap gap-2.5">
              {topicLinks.map((t) => <li><a href={topicHref(t)} class="topic-chip">{t.topic.data.title}</a></li>)}
              {qualityLinks.map((q) => <li><a href={`/books/?helps=${q.quality.id}`} class="topic-chip">Helps with: {q.quality.data.title}</a></li>)}
            </ul>
          </nav>
        )}
      </section>
      <aside aria-labelledby="details" class="self-start rounded-[var(--radius-card)] bg-white p-6">
        <h2 id="details" class="text-2xl">Book details</h2>
        <dl class="mt-3 divide-y divide-line">
          {details.filter(([, v]) => !!v).map(([k, v]) => (
            <div class="flex justify-between gap-4 py-2.5"><dt class="text-ink-soft">{k}</dt><dd class="text-right font-bold text-plum-deep">{v}</dd></div>
          ))}
        </dl>
      </aside>
    </div>

    {series.id === 'big-questions' && <WhatsInside heading="h2" title="What’s inside this book" />}

    {bookReviews.length > 0 && (
      <section aria-labelledby="book-reviews" class="flex flex-col gap-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="book-reviews" class="text-[2.1rem]">What families say</h2>
          <a href={`/reviews/?book=${book.id}#write`} class="font-extrabold">Share your review <span aria-hidden="true">→</span></a>
        </div>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {bookReviews.map((t) => <li><TestimonialCard t={t} showBook={false} /></li>)}
        </ul>
      </section>
    )}

    {printables.length > 0 && (
      <section aria-labelledby="printables" class="flex flex-col gap-6 rounded-[var(--radius-panel)] bg-yellow p-6 sm:p-10">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <div class="flex flex-col gap-1">
            <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-plum-deep">Free printables</p>
            <h2 id="printables" class="text-[2.1rem] !text-plum-deep">Activities for this book</h2>
            <p class="text-plum-deep">Free to print at home or in class. No sign-up needed.</p>
          </div>
          <a href={`/activities/?collection=${collection.id}`} class="font-extrabold text-plum-deep">More {collection.data.title} printables <span aria-hidden="true">→</span></a>
        </div>
        <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {ownResources.map((r) => <li class="flex [&>*]:w-full"><ActivityCard resource={r} headingLevel="h3" showBooks={false} placement="book-page" /></li>)}
          {suitsResources.map((r) => <li class="flex [&>*]:w-full"><ActivityCard resource={r} headingLevel="h3" placement="book-page" /></li>)}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section aria-labelledby="related" class="flex flex-col gap-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="related" class="text-[2.1rem]">More {collection.data.title}</h2>
          <a href={collectionUrl(collection)} class="font-extrabold">See the whole collection <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((b) => <BookCard book={b} showSeries={false} />)}
        </div>
      </section>
    )}
    <NewsletterSignup id="book-signup" compact source={`book:${book.id}`} />
    {isScience
      ? <AboutCreator eyebrow="The scientist behind the story" text={`${SITE.creator.name}, a biomedical scientist (PhD), chose ${d.title}, researched their life from reliable sources and checked every fact in this book.`} />
      : <AboutCreator />}
  </div>
  <Lightbox id="book-pictures" title={d.title} />
  <BuyBar book={book} target="buy" />
</BaseLayout>
