---
/**
 * HOMEPAGE
 * Order: hero · collections (Bobbin's World and Little Scientists side by side, then Timeless Tales and
 * Little Body Explorers) · new books · themed editions · find a book by interest · why parents choose us ·
 * free resources · the scientist behind the stories · Learning Club.
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import CollectionCard from '../components/CollectionCard.astro';
import EditionCard from '../components/EditionCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Sparkle from '../components/Sparkle.astro';
import Planet from '../components/Planet.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import AboutCreator from '../components/AboutCreator.astro';
import {
  type Book, getAllCollections, getBooksInCollection, getVisibleEditions, getTopicsInUse, getQualitiesInUse, topicHref,
} from '../lib/books';
import { SITE, AMAZON_STORES } from '../site.config';

const collections = await getAllCollections();
const main = collections.filter((c) => c.id === 'bobbins-world' || c.id === 'little-scientists');
const secondary = collections.filter((c) => !main.includes(c));

// NEW AND LOVED: the two newest books from each main collection, so both get equal space.
const newest = async (id: string) => {
  const books = await getBooksInCollection(id);
  // Little Scientists: newest published books. Bobbin's World: newest books, including the one coming soon.
  const pool = id === 'little-scientists' ? books.filter((b) => b.data.status === 'published') : books;
  return pool.slice(-2).reverse();
};
const newBooks = [...(await newest('bobbins-world')), ...(await newest('little-scientists'))];

// Hero pictures: one cover from each collection (edit the file names here).
const HERO_IDS = ['marie-curie', 'bobbin-and-the-wobble-bridge', 'hanuman-ocean-leap'];
const heroBooks = (await Promise.all(HERO_IDS.map((id) => getEntry('books', id)))).filter(Boolean) as Book[];

const editions = await getVisibleEditions();
const topics = await getTopicsInUse();
const qualities = await getQualitiesInUse();

const reasons = [
  ['Created by a scientist', 'Each science story is researched from reliable sources and fact-checked by a biomedical scientist (PhD).', 'bg-mint-soft'],
  ['Made for reading aloud', 'Short, warm sentences for ages 4–8, with questions to talk about along the way.', 'bg-yellow-soft'],
  ['Feelings, gently', 'Bobbin’s stories show what helps with big feelings, without lecturing.', 'bg-lavender-soft'],
  ['Free extras for every book', 'Read-aloud guides for every book, plus activity packs and word searches, free to print at home or in class.', 'bg-coral-soft'],
];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/brand/icon-512.png`,
  slogan: SITE.tagline,
  description: SITE.description,
  ...(SITE.contactEmail ? { email: SITE.contactEmail } : {}),
  sameAs: Object.values(SITE.social).filter(Boolean),
};
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url };
---
<BaseLayout title="Tarkasa Tales: Children’s Science Picture Books for Ages 4–8" description="Picture books for ages 4–8 about real scientists, big feelings and timeless tales, with free printables and a monthly Learning Club for parents and teachers." jsonLd={[orgLd, siteLd]}>
  <!-- HERO -->
  <section aria-labelledby="hero-title" class="relative overflow-hidden">
    <div class="container-site grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-20">
      <div class="flex flex-col gap-6">
        <p class="inline-flex items-center gap-2 self-start rounded-full bg-white px-4 py-2 text-sm font-extrabold text-plum">
          <Sparkle size={16} /> Picture books for ages 4–8 · created by a scientist
        </p>
        <h1 id="hero-title" class="text-[2.9rem] sm:text-6xl lg:text-[4.4rem] leading-[1.02]">Little Questions.<br />Big Discoveries.</h1>
        <p class="max-w-xl text-lg sm:text-xl leading-relaxed">
          Beautifully illustrated stories that help children explore science, understand big feelings and discover the wonderful world around them.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/books/" class="btn btn-primary text-[1.0625rem] min-h-[3.4rem] px-8">Explore Our Books</a>
          <a href="/activities/" class="btn btn-secondary text-[1.0625rem] min-h-[3.4rem] px-8">Discover Free Activities</a>
        </div>
        <p class="text-[0.9375rem] text-ink-soft">Paperback and Kindle on Amazon in {AMAZON_STORES.length} countries · free printables for every book</p>
        <a href="/gifts/" class="inline-flex items-center gap-2 self-start rounded-full bg-coral-soft px-4 py-2 font-extrabold text-plum-deep no-underline hover:underline"><Sparkle size={16} color="#C9575C" /> Looking for a gift? See gift ideas for curious kids <span aria-hidden="true">→</span></a>
      </div>

      <div class="relative mx-auto h-[19rem] w-full max-w-[34rem] sm:h-[28rem]" aria-hidden="true">
        <div class="absolute inset-[6%_0_0_6%] rounded-[48%_52%_44%_56%/52%_46%_54%_48%] bg-yellow"></div>
        <Planet size={120} class="absolute right-[4%] top-0" />
        <Sparkle size={40} color="#F39A9D" class="absolute left-0 top-[2%]" />
        <Sparkle size={26} color="#53406C" class="absolute left-[10%] bottom-[4%]" />
        {heroBooks.map((b, i) => (
          <Image
            src={b.data.cover}
            alt=""
            widths={[240, 360, 480]}
            sizes="(min-width: 640px) 220px, 40vw"
            loading="eager"
            class:list={[
              'absolute aspect-square rounded-xl object-cover border-[5px] border-white shadow-[0_22px_36px_rgba(46,33,64,0.25)]',
              i === 0 && 'left-[30%] top-[6%] w-[40%] z-20',
              i === 1 && 'left-[5%] top-[22%] w-[35%] -rotate-[8deg] z-10',
              i === 2 && 'right-[3%] top-[26%] w-[33%] rotate-[7deg] z-10',
            ]}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- COLLECTIONS -->
  <section aria-labelledby="collections" class="container-site flex flex-col gap-7 pb-16">
    <SectionHeading eyebrow="Explore" title="Our collections" id="collections" linkHref="/collections/" linkLabel="All collections" />
    <div class="grid gap-6 lg:grid-cols-2">
      {main.map((c) => <CollectionCard collection={c} />)}
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {secondary.map((c) => <CollectionCard collection={c} size="small" />)}
    </div>
  </section>

  <!-- NEW AND LOVED -->
  {newBooks.length > 0 && (
    <section aria-labelledby="new-books" class="rounded-t-[3rem] bg-white/70">
      <div class="container-site flex flex-col gap-8 py-16">
        <SectionHeading eyebrow="New and loved" title="Featured books" id="new-books" linkHref="/books/" linkLabel="See all books" />
        <ul class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
          {newBooks.map((b) => <li class="flex [&>*]:w-full"><BookCard book={b} compact /></li>)}
        </ul>
      </div>
    </section>
  )}

  <div class:list={['flex flex-col gap-16 pb-16', newBooks.length > 0 ? 'bg-white/70' : 'pt-16']}>
    <!-- THEMED EDITIONS -->
    {editions.length > 0 && (
      <section aria-labelledby="home-editions" class="container-site flex flex-col gap-6">
        <h2 id="home-editions" class="sr-only">Themed editions</h2>
        {editions.map((e) => <EditionCard edition={e} headingLevel="h3" />)}
      </section>
    )}

    <!-- FIND A BOOK BY INTEREST -->
    {topics.length > 0 && (
      <section aria-labelledby="interests" class="container-site flex flex-col gap-5">
        <SectionHeading eyebrow="Find the right book" title="Start with what they love" id="interests" linkHref="/topics/" linkLabel="All topics" />
        <ul class="flex flex-wrap gap-2.5" aria-label="Topics">
          {topics.map((t) => <li><a href={topicHref(t)} class="topic-chip">{t.topic.data.title}</a></li>)}
        </ul>
        {qualities.length > 0 && (
          <div class="flex flex-col gap-3">
            <p class="font-extrabold text-plum-deep">Or by what it helps with:</p>
            <ul class="flex flex-wrap gap-2.5" aria-label="What the books help with">
              {qualities.map((q) => <li><a href={`/books/?helps=${q.quality.id}`} class="topic-chip !bg-white">{q.quality.data.title}</a></li>)}
            </ul>
          </div>
        )}
      </section>
    )}
  </div>

  <!-- WHY PARENTS CHOOSE US -->
  <section aria-labelledby="why-us" class="container-site flex flex-col gap-7 py-16">
    <SectionHeading title="Why parents and teachers choose Tarkasa Tales" id="why-us" />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {reasons.map(([t, d, c]) => (
        <li class:list={['flex flex-col gap-2 rounded-[var(--radius-card)] p-6 text-plum-deep', c]}>
          <h3 class="text-xl !text-plum-deep">{t}</h3>
          <p>{d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- FREE RESOURCES -->
  <section aria-labelledby="activities" class="container-site pb-16">
    <div class="flex flex-wrap items-center gap-10 rounded-[2.5rem] bg-yellow px-7 py-12 sm:px-12 text-plum-deep">
      <div class="flex min-w-[16rem] flex-1 flex-col gap-4">
        <p class="text-sm font-extrabold uppercase tracking-[0.12em]">Free resources · no sign-up needed</p>
        <h2 id="activities" class="text-[2.1rem] sm:text-[2.6rem] !text-plum-deep">Keep the curiosity going after the last page</h2>
        <p class="text-lg">Activity packs, word searches and read-aloud guides for grown-ups to print and enjoy with young readers, at home or in class.</p>
        <a href="/activities/" class="btn btn-dark self-start">Discover Free Activities</a>
      </div>
      <ul class="hidden flex-1 min-w-[16rem] grid-cols-3 gap-3 sm:grid sm:gap-4">
        {[['Activity packs', 'from the books'], ['Word searches', 'with answers'], ['Read-aloud guides', 'for grown-ups']].map(([t, d]) => (
          <li class="flex flex-col items-center gap-1 rounded-3xl bg-cream px-2 py-5 text-center"><span class="font-extrabold">{t}</span><span class="text-sm">{d}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THE SCIENTIST BEHIND THE STORIES -->
  <div class="container-site pb-16"><AboutCreator eyebrow="The scientist behind the stories" title="Every book starts with a question" /></div>

  <!-- LEARNING CLUB (hidden until brevoFormAction is set in site.config.ts) -->
  {SITE.brevoFormAction && <div class="container-site pb-20"><NewsletterSignup id="home-signup" source="home" /></div>}
</BaseLayout>
