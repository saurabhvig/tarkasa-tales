---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import Sparkle from '../../components/Sparkle.astro';
import { getAllSeries } from '../../lib/books';
const series = await getAllSeries();
---
<BaseLayout title="Book Series" description="Explore the Tarkasa Tales book series: Little Scientists and Hindu Mythology Stories, with more collections to come.">
  <div class="container-site flex flex-col gap-10 py-12 lg:py-16">
    <div class="flex max-w-3xl flex-col gap-3">
      <p class="eyebrow inline-flex items-center gap-2"><Sparkle size={16} /> Our collections</p>
      <h1 class="text-5xl sm:text-6xl">Book Series</h1>
      <p class="text-lg sm:text-xl">Each collection explores a different way of being curious — from real scientists and their discoveries to timeless traditional stories.</p>
    </div>
    <div class="grid gap-7 lg:grid-cols-2">
      {series.map((s) => <SeriesCard series={s} headingLevel="h2" />)}
    </div>
    <p class="text-lg text-ink-soft">More collections are planned. New series will appear here as they are published.</p>
  </div>
</BaseLayout>
