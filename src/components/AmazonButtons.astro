---
import { type Book, amazonLinks, canBuy } from '../lib/books';
interface Props { book: Book }
const { book } = Astro.props;
const links = amazonLinks(book);
// Stores listed alphabetically by country so visitors can find theirs quickly.
const sorted = [...links].sort((a, b) => a.region.localeCompare(b.region));
const buy = canBuy(book);
const soon = book.data.status === 'coming-soon';
---
<section aria-labelledby="buy-heading" class="rounded-[var(--radius-card)] border-2 border-yellow bg-white p-6 flex flex-col gap-4">
  {buy ? (
    <>
      <h2 id="buy-heading" class="text-2xl">{soon ? 'Preorder this book' : 'Buy this book'}</h2>
      <details class="buy-menu">
        <summary class="btn btn-primary w-full !min-h-14 text-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h2l2 11h11l2-8H7.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="10" cy="20" r="1.4" fill="currentColor"></circle><circle cx="18" cy="20" r="1.4" fill="currentColor"></circle></svg>
          {soon ? 'Preorder on Amazon' : 'Buy on Amazon'}
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </summary>
        <div class="mt-3 rounded-2xl bg-cream p-4">
          <p class="mb-3 font-extrabold text-plum-deep">Choose your country’s Amazon store:</p>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {sorted.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer" data-store={l.key} class="store-link flex min-h-14 flex-col justify-center rounded-xl border-2 border-transparent bg-white px-3 py-2 no-underline hover:border-plum hover:bg-lavender-soft">
                  <span class="font-extrabold text-plum-deep">{l.region}</span>
                  <span class="text-sm text-ink-soft">{l.label}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
      <p class="text-sm text-ink-soft">You’ll be taken to Amazon, where prices, availability and delivery are shown.</p>
    </>
  ) : soon ? (
    <>
      <h2 id="buy-heading" class="text-2xl">Coming soon</h2>
      <p>This book isn’t available to order yet.{book.data.expectedRelease && <> Expected: <strong>{book.data.expectedRelease}</strong>.</>} Check back soon, or explore our published books in the meantime.</p>
      <a href="/books/?status=published" class="btn btn-secondary self-start">See available books</a>
    </>
  ) : (
    <>
      <h2 id="buy-heading" class="text-2xl">Buy on Amazon</h2>
      <p class="font-bold text-plum">Amazon links will appear here once they are added to this book’s file.</p>
    </>
  )}
</section>

<style>
  .buy-menu summary { list-style: none; }
  .buy-menu summary::-webkit-details-marker { display: none; }
  .buy-menu .chev { transition: transform .15s ease; }
  .buy-menu[open] .chev { transform: rotate(180deg); }
  .store-link.is-suggested { border-color: var(--color-yellow); }
  .store-link.is-suggested::after { content: 'Suggested for you'; margin-top: .25rem; font-size: .75rem; font-weight: 800; color: var(--color-plum-deep); }
</style>

<script>
  // Highlight the visitor's likely Amazon store, based on their browser language. Nothing is stored or sent anywhere.
  const map: Record<string, string> = { 'en-US': 'com', 'en-GB': 'couk', 'en-IE': 'ie', 'en-IN': 'in', 'hi': 'in', 'en-CA': 'ca', 'fr-CA': 'ca', 'en-AU': 'au', 'de': 'de', 'nl-BE': 'be', 'fr-BE': 'be', 'nl': 'nl', 'fr': 'fr', 'es': 'es', 'it': 'it', 'pl': 'pl', 'sv': 'se', 'ja': 'jp' };
  const langs = navigator.languages?.length ? navigator.languages : [navigator.language];
  let key: string | undefined;
  for (const l of langs) { key = map[l] ?? map[l.split('-')[0]]; if (key) break; }
  if (key) document.querySelectorAll<HTMLAnchorElement>(`.store-link[data-store="${key}"]`).forEach((a) => a.classList.add('is-suggested'));
</script>
