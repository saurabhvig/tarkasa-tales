---
import Logo from './Logo.astro';
import { SITE } from '../site.config';
import { getAllCollections, collectionUrl } from '../lib/books';
const collections = await getAllCollections();
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, url]) => !!url) as [string, string][];
const label = (k: string) => k.charAt(0).toUpperCase() + k.slice(1);
---
<footer class="bg-plum text-cream mt-auto">
  <div class="container-site pt-14 pb-8 flex flex-col gap-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1fr]">
      <div class="flex flex-col gap-3">
        <Logo reversed />
        <p class="text-[#E9E1F7] max-w-xs">{SITE.tagline}</p>
      </div>
      <nav aria-label="Footer — collections" class="flex flex-col gap-2">
        <h2 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] text-yellow">Collections</h2>
        {collections.map((c) => c.data.status === 'active'
          ? <a class="text-cream no-underline hover:underline hover:text-cream" href={collectionUrl(c)}>{c.data.title}</a>
          : <span class="text-[#E9E1F7]">{c.data.title} (soon)</span>)}
      </nav>
      <nav aria-label="Footer — explore" class="flex flex-col gap-2">
        <h2 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] text-yellow">Explore</h2>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/books/">All books</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/topics/">Books by topic</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/activities/">Free Resources</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/learning-club/">Learning Club</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/coming-soon/">Coming soon</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/gifts/">Gift ideas</a>
      </nav>
      <nav aria-label="Footer — about" class="flex flex-col gap-2">
        <h2 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] text-yellow">Tarkasa Tales</h2>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/about/">About</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/reviews/">Reviews</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/contact/">Contact</a>
        <a class="text-cream no-underline hover:underline hover:text-cream" href="/privacy/">Privacy &amp; Cookies</a>
      </nav>
      <div class="flex flex-col gap-2">
        <h2 class="font-sans text-sm font-extrabold uppercase tracking-[0.1em] text-yellow">Say hello</h2>
        {SITE.contactEmail
          ? <a class="text-cream hover:text-cream break-all" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          : <a class="text-cream no-underline hover:underline hover:text-cream" href="/contact/">Contact page</a>}
        {socials.map(([k, url]) => (
          <a class="inline-flex items-center gap-2 text-cream no-underline hover:underline hover:text-cream" href={url} rel="me noopener" target="_blank">{k === 'instagram' && <Fragment set:html={`<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"></rect><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"></circle></svg>`} />}{k === 'instagram' ? '@tarkasatales on Instagram' : label(k)}<span class="sr-only"> (opens in a new tab)</span></a>
        ))}
      </div>
    </div>
    <div class="border-t border-[#7A6893] pt-6 flex flex-wrap justify-between gap-3 text-sm text-[#E9E1F7]">
      <p>© {year} Tarkasa Tales. All rights reserved.</p>
      <p>Books are sold and fulfilled by Amazon. Amazon is a trademark of Amazon.com, Inc. or its affiliates.</p>
    </div>
  </div>
</footer>
