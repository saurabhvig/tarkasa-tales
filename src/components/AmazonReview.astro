---
// "Read it already? Leave a review" box on published book pages.
// Links to each Amazon store's "write a review" page for this book.
import { type Book, reviewLinks } from '../lib/books';
interface Props { book: Book }
const { book } = Astro.props;
const links = [...reviewLinks(book)].sort((a, b) => a.region.localeCompare(b.region));
---
{links.length > 0 && (
  <section aria-labelledby="review-heading" class="flex flex-col gap-4 rounded-[var(--radius-card)] bg-lavender-soft p-6">
    <h2 id="review-heading" class="text-2xl">Read it already?</h2>
    <p>An honest review on Amazon helps other families find this book, and it means a lot to a small, independent publisher. It only takes a minute.</p>
    <details class="review-menu">
      <summary class="btn btn-secondary w-full !min-h-14 text-lg">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
        Leave a review on Amazon
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </summary>
      <div class="mt-3 rounded-2xl bg-white p-4">
        <p class="mb-3 font-extrabold text-plum-deep">Review on the Amazon store where you bought it:</p>
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" data-umami-event="amazon-review-click" data-umami-event-book={book.id} data-umami-event-store={l.key} class="flex min-h-14 flex-col justify-center rounded-xl border-2 border-transparent bg-cream px-3 py-2 no-underline hover:border-plum hover:bg-lavender-soft">
                <span class="font-extrabold text-plum-deep">{l.region}</span>
                <span class="text-sm text-ink-soft">{l.label}</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
    <p class="text-sm text-ink-soft">Amazon asks you to sign in first. Or <a href={`/reviews/?book=${book.id}#write`}>tell us what you thought on our website</a>.</p>
  </section>
)}

<style>
  .review-menu summary { list-style: none; }
  .review-menu summary::-webkit-details-marker { display: none; }
  .review-menu .chev { transition: transform .15s ease; }
  .review-menu[open] .chev { transform: rotate(180deg); }
</style>
