---
/**
 * Site header: logo, four menu items and a "Browse books" button.
 * "Books" has a small submenu with the collections (opens on click/tap, Escape closes it).
 * Without JavaScript every link is simply shown, so nothing is ever unreachable.
 */
import Logo from './Logo.astro';
import { getAllCollections, collectionUrl } from '../lib/books';

const collections = await getAllCollections();
// The Books submenu. Coming-soon collections appear as plain text with "(soon)".
const BOOKS_MENU = [
  ...collections.map((c) => ({ href: c.data.status === 'active' ? collectionUrl(c) : undefined, label: c.data.title, soon: c.data.status !== 'active' })),
  { href: '/books/', label: 'All books', soon: false },
  { href: '/topics/', label: 'Books by topic', soon: false },
  { href: '/coming-soon/', label: 'Coming soon', soon: false },
  { href: '/gifts/', label: 'Gift ideas', soon: false },
];
const NAV = [
  { href: '/activities/', label: 'Free Resources', match: ['/activities/', '/resources/'] },
  { href: '/learning-club/', label: 'Learning Club', match: ['/learning-club/'] },
  { href: '/about/', label: 'About', match: ['/about/'] },
];
const path = Astro.url.pathname;
const booksCurrent = ['/books/', '/collections/', '/topics/', '/coming-soon/', '/gifts/'].some((p) => path.startsWith(p));
const linkCls = 'nav-link block rounded-full px-4 lg:px-3.5 py-3 lg:py-2.5 font-bold no-underline text-ink hover:bg-white hover:text-plum aria-[current=page]:bg-white aria-[current=page]:text-plum aria-[current=page]:font-extrabold';
---
<header class="site-header border-b border-line bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85 relative z-30">
  <div class="container-site flex items-center justify-between gap-3 py-3">
    <Logo />
    <div class="flex items-center gap-2 lg:hidden">
      <a href="/books/" class="btn btn-secondary !min-h-12 !px-3.5 whitespace-nowrap text-[0.9375rem] max-[359px]:hidden">Browse books</a>
      <button
        type="button"
        class="menu-toggle inline-flex items-center justify-center gap-2 min-h-12 min-w-12 px-3 sm:px-4 rounded-2xl bg-plum text-cream font-extrabold"
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="i-open" d="M4 7H20M4 12H20M4 17H14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"></path><path class="i-close" d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"></path></svg>
        <span class="max-[479px]:sr-only">Menu</span>
      </button>
    </div>
    <nav id="site-nav" aria-label="Main" class="site-nav">
      <ul class="flex flex-col lg:flex-row lg:items-center gap-1">
        <li class="books-item relative">
          <div class="flex items-center">
            <a href="/books/" aria-current={booksCurrent ? 'page' : undefined} class={`${linkCls} lg:!pr-1.5 flex-1`}>Books</a>
            <button type="button" class="sub-toggle inline-flex h-11 w-11 items-center justify-center rounded-full text-plum hover:bg-white" aria-expanded="false" aria-controls="books-menu">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <span class="sr-only">Show book collections</span>
            </button>
          </div>
          <ul id="books-menu" class="books-menu">
            {BOOKS_MENU.map((m, i) => (
              <li class:list={[i === collections.length && 'mt-1 border-t border-line pt-1']}>
                {m.href
                  ? <a href={m.href} aria-current={path === m.href ? 'page' : undefined} class="block rounded-xl px-4 py-2.5 font-bold no-underline text-ink hover:bg-cream hover:text-plum aria-[current=page]:text-plum aria-[current=page]:font-extrabold">{m.label}</a>
                  : <span class="block px-4 py-2.5 font-bold text-ink-soft">{m.label} <span class="text-sm">(soon)</span></span>}
              </li>
            ))}
          </ul>
        </li>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={item.match.some((m) => path.startsWith(m)) ? 'page' : undefined} class={linkCls}>{item.label}</a>
          </li>
        ))}
        <li class="hidden lg:ml-2 lg:list-item">
          <a href="/books/" class="btn btn-primary w-full lg:w-auto">Browse books</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .i-close { display: none; }
  .menu-toggle[aria-expanded='true'] .i-open { display: none; }
  .menu-toggle[aria-expanded='true'] .i-close { display: inline; }
  .sub-toggle svg { transition: transform .15s ease; }
  .sub-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* Books submenu: in place on phones, a small drop-down panel on large screens. With JavaScript it starts closed. */
  .books-menu { padding: 0.25rem 0 0.5rem 1rem; }
  :global(.js) .books-menu:not(.is-open) { display: none; }
  @media (min-width: 1024px) {
    .books-menu {
      position: absolute; left: 0; top: calc(100% + 0.5rem); min-width: 15rem; padding: 0.5rem;
      background: #fff; border: 1px solid var(--color-line); border-radius: 1.25rem;
      box-shadow: 0 18px 36px rgba(46, 33, 64, 0.16); z-index: 40;
    }
    :global(.no-js) .books-menu { display: none; }
    :global(.no-js) .sub-toggle { display: none; }
  }

  /* Without JavaScript the menu is always shown, so nothing is ever unreachable. */
  @media (max-width: 1023.98px) {
    :global(.js) .site-nav { display: none; }
    :global(.js) .site-nav.is-open {
      display: block; position: absolute; left: 0; right: 0; top: 100%;
      max-height: calc(100dvh - 100%); overflow-y: auto;
      background: var(--color-cream); border-bottom: 1px solid var(--color-line);
      padding: 0.5rem 1rem 1.25rem; box-shadow: 0 18px 30px rgba(46, 33, 64, 0.12);
    }
    .site-nav { width: 100%; }
    .site-header > div { flex-wrap: wrap; }
    :global(.js) .site-header > div { flex-wrap: nowrap; }
    .nav-link { font-size: 1.125rem; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const sub = document.querySelector<HTMLButtonElement>('.sub-toggle');
  const subMenu = document.getElementById('books-menu');
  const setSub = (open: boolean) => {
    sub?.setAttribute('aria-expanded', String(open));
    subMenu?.classList.toggle('is-open', open);
  };
  sub?.addEventListener('click', (e) => { e.stopPropagation(); setSub(sub.getAttribute('aria-expanded') !== 'true'); });
  // Close the drop-down when clicking elsewhere or moving focus out of it (large screens).
  document.addEventListener('click', (e) => {
    if (window.matchMedia('(min-width: 1024px)').matches && !(e.target as Element).closest('.books-item')) setSub(false);
  });
  document.querySelector('.books-item')?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Element | null;
    if (window.matchMedia('(min-width: 1024px)').matches && (!next || !next.closest('.books-item'))) setSub(false);
  });

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      if (!open) setSub(false);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (sub?.getAttribute('aria-expanded') === 'true') { setSub(false); sub.focus(); return; }
    if (toggle?.getAttribute('aria-expanded') === 'true') { toggle.click(); toggle.focus(); }
  });
</script>
