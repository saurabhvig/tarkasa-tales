---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, IS_PREVIEW } from '../site.config';

interface Props {
  title: string;              // page title (brand is appended automatically)
  description?: string;       // 50–160 characters for search results
  image?: string;             // absolute or root-relative social image
  imageAlt?: string;
  type?: 'website' | 'book';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = SITE.description, image = '/og-default.png', imageAlt = 'Tarkasa Tales — Little Questions. Big Discoveries.', type = 'website', noindex = false, jsonLd } = Astro.props;
// The brand is added after the page title, unless the title already names it or the result would be too long
// for search results (about 65 characters), where the page's own words matter more.
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}`
  : title.includes(SITE.name) || `${title} | ${SITE.name}`.length > 65 ? title
  : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {IS_PREVIEW ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}
    {!IS_PREVIEW && SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {!IS_PREVIEW && SITE.verification.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}
    <meta name="theme-color" content="#53406C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {/* Cookieless visitor statistics (Umami Cloud, EU region). Only loads when umamiWebsiteId is set. See /privacy/. */}
    {SITE.umamiWebsiteId && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={SITE.umamiWebsiteId} data-domains="tarkasatales.com,www.tarkasatales.com" data-do-not-track="true"></script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn-primary">Skip to main content</a>
    {IS_PREVIEW && <p class="bg-plum-deep px-4 py-2 text-center text-sm font-bold text-cream">Preview of a draft version. This is not the live Tarkasa Tales website; forms are switched off here.</p>}
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
